# PantryNanny backend configuration. Copy to /etc/pantrynanny/pantrynanny.env (mode 0600)
# in production, or backend/.env for local development. Never commit real values.

# PostgreSQL (async driver). Postgres must only listen on localhost.
PN_DATABASE_URL=postgresql+asyncpg://pantrynanny:CHANGE_ME@127.0.0.1:5432/pantrynanny

# Public URL behind the reverse proxy (used for absolute links, CORS and cookie security)
PN_PUBLIC_URL=https://pantry.example.com
# Comma separated extra CORS origins (the public URL is always allowed). Empty = same-origin only.
PN_CORS_ORIGINS=
# IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are trusted
# Add the IP of your TLS-terminating reverse proxy (Traefik, Caddy, ...), e.g. 127.0.0.1,192.0.2.10
PN_TRUSTED_PROXIES=127.0.0.1

# Uploaded product photos
PN_UPLOAD_DIR=/var/lib/pantrynanny/uploads

# Logging: json or console; level: DEBUG/INFO/WARNING
PN_LOG_FORMAT=json
PN_LOG_LEVEL=INFO

# External product lookup
PN_OFF_ENABLED=true
PN_OFF_BASE_URL=https://world.openfoodfacts.org
# Open Food Facts asks for an identifying User-Agent with a contact address
PN_OFF_USER_AGENT="PantryNanny/1.0 (self-hosted household app; contact: you@example.com)"
PN_LOOKUP_TIMEOUT_S=3
# Optional commercial providers (disabled unless a key is set)
PN_EANSEARCH_TOKEN=

# Optional local AI (OpenAI-compatible). Leave PN_AI_BASE_URL empty to disable.
# Example: http://192.0.2.20:8080/v1 (llama.cpp server, vLLM, Ollama /v1, ...)
PN_AI_BASE_URL=
PN_AI_API_KEY=
# Empty = auto-detect the first model reported by /v1/models
PN_AI_MODEL=
PN_AI_TIMEOUT_S=90
