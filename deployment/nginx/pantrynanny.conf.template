# PantryNanny – rendered by deployment/install.sh. Do not edit in place; edit the template.
# Listens on 0.0.0.0:8734. TLS is terminated by the external reverse proxy (Traefik).

upstream pantrynanny_api {
    server 127.0.0.1:8000;
    keepalive 16;
}

# Only trust X-Forwarded-* headers from the reverse proxy.
@@REAL_IP_FROM@@
real_ip_header X-Forwarded-For;
real_ip_recursive on;

geo $realip_remote_addr $pn_trusted_proxy {
    default 0;
@@GEO_TRUSTED@@
}
map "$pn_trusted_proxy:$http_x_forwarded_proto" $pn_forwarded_proto {
    default        $scheme;
    "~^1:(https?)$" $1;
}
map "$pn_trusted_proxy:$http_x_forwarded_host" $pn_forwarded_host {
    default    $http_host;
    "~^1:(.+)$" $1;
}
# Access log with what the reverse proxy saw (scheme, host) and timings, to debug proxy
# problems and follow scan/sync latency in production.
log_format pantrynanny '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
                       '"$http_referer" "$http_user_agent" proto=$pn_forwarded_proto '
                       'host=$pn_forwarded_host rt=$request_time urt=$upstream_response_time';

map $http_upgrade $pn_connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 8734 default_server;
    listen [::]:8734 default_server;
    server_name _;

    root /opt/pantrynanny/current/web;
    index index.html;

    client_max_body_size 12m;
    server_tokens off;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json text/csv;

    # nginx drops inherited add_header directives in any location that sets its own,
    # so every such location re-includes the security headers.
    include /etc/nginx/snippets/pantrynanny-headers.conf;

    access_log /var/log/nginx/pantrynanny.access.log pantrynanny;
    error_log  /var/log/nginx/pantrynanny.error.log warn;

    location = /nginx-health { access_log off; return 200 "ok\n"; }

    # Product photos (unguessable UUID file names), cached aggressively.
    location /api/media/ {
        alias /var/lib/pantrynanny/uploads/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        include /etc/nginx/snippets/pantrynanny-headers.conf;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://pantrynanny_api;
        proxy_http_version 1.1;
        proxy_set_header Host $pn_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $pn_forwarded_proto;
        proxy_set_header X-Forwarded-Host $pn_forwarded_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $pn_connection_upgrade;
        proxy_read_timeout 120s;   # AI assistant calls can be slow
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/pantrynanny-headers.conf;
        # The API restarts for a few seconds during a deploy: answer "try again shortly" instead
        # of a bare 502. Clients keep their queued scans and retry.
        error_page 502 = @api_restarting;
    }

    location @api_restarting {
        default_type application/json;
        add_header Retry-After 3 always;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/pantrynanny-headers.conf;
        return 503 '{"detail":"PantryNanny is restarting, try again in a few seconds","code":"restarting"}';
    }

    # Service worker and entry points must never be cached by intermediaries.
    location = /sw.js { add_header Cache-Control "no-cache" always; include /etc/nginx/snippets/pantrynanny-headers.conf; try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-cache" always; include /etc/nginx/snippets/pantrynanny-headers.conf; }
    location = /manifest.webmanifest { add_header Cache-Control "no-cache" always; include /etc/nginx/snippets/pantrynanny-headers.conf; default_type application/manifest+json; try_files $uri =404; }
    location = /manifest-scan.webmanifest { add_header Cache-Control "no-cache" always; include /etc/nginx/snippets/pantrynanny-headers.conf; default_type application/manifest+json; try_files $uri =404; }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/pantrynanny-headers.conf;
        try_files $uri =404;
    }

    # Android app (built by deployment/deploy.sh). Revalidated on every request so phones get the newest build.
    location /downloads/ {
        types { application/vnd.android.package-archive apk; application/json json; }
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/pantrynanny-headers.conf;
        try_files $uri =404;
    }

    # SPA fallback (/scan, /inventory, ...)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
