# Copy to deployment/site.env (gitignored) and adjust. Sourced by deployment/deploy.sh.
# ssh:<user@host>              deploy directly over SSH to the container
# pct:<user@proxmox-host>:<ctid>  push via the Proxmox host (pct push / pct exec)
PN_DEPLOY_TARGET=ssh:root@pantry-host
# Extra ssh/scp options, e.g. an identity file
PN_DEPLOY_SSH_OPTS="-i $HOME/.ssh/id_ed25519"
